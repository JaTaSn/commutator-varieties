# `(R₀)`: `I_k` is reduced at each of its minimal primes

At a minimal prime `P_j` of `I_k` (`MinimalPrimes.lean`), the local ring
`(R/I_k)_{P_j}` is a field; equivalently, `I_k` generates the maximal ideal of
`R_{P_j}`:

    I_k · R_{P_j} = P_j · R_{P_j}      for every 2 ≤ j ≤ k     (`map_Ik_eq_maximalIdeal`)

This is Serre's `(R₀)` for `R/I_k`, half of the article's radicality argument.
The other half, `(S₁)` (no embedded primes), is not here; with both,
`I_k = P₂ ∩ ⋯ ∩ P_k` (`radical_Ik` gives the radical).

## The argument — no Jacobian

The 2026-11-12 working note sketched `(R₀)` at the inherited components through
the Jacobian at the generic point, and Nakayama.  It turns out not to be needed.
Two facts suffice.

1. **At the new component**, `j = k`: the saturation
   `P_k ⊆ (I_k : uᵢ^∞)` (`exists_pow_mul_mem_Ik`), with `uᵢ ∉ P_k`
   (`exists_dir_not_mem_P`), says `I_k R_{P_k} = P_k R_{P_k}` directly.
2. **Going up one step**, from `I_{k-1}` to `I_k`, at a `P_j` with `j < k`:
   with `u = D(w_{k-1})` and `a = D(v_{k-1})`, the vector triple product gives

       a ⨯ w_k = a ⨯ (u ⨯ v_k) = (a · v_k) u − (a · u) v_k = (a · v_k) u,

   since `a · u = v_{k-1} · w_{k-1} = 0`.  So `s · I_{k-1} ⊆ I_k` with
   `s = a · v_k = v_{k-1} · D(v_k)` — the incidence form `inc` of
   `MinimalPrimes.lean`, already shown not to lie in any earlier `P_j`
   (`inc_not_mem_P`).  As also `I_k ⊆ I_{k-1}` (`Ik_succ_le`), the two
   ideals agree after inverting `s`, so in `R_{P_j}` (`map_Ik_succ_eq`).

Induction on `k` from `j` finishes it.  So (R₀) needs no regular local rings,
no dimension, and no separability of the residue field.

## Indexing

`P m` is the article's `P_{m+2}`; `Ik k` is the article's `I_k`.  So the
hypothesis `m + 2 ≤ k` is the article's `j ≤ k`.
-/
import KCommuting.MinimalPrimes
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.Algebra.Field.ZMod

open MvPolynomial Matrix

namespace KCommuting

variable {F : Type*} [Field F]

/-! ### Two facts about cross products and ideals -/

section Cross

variable {R : Type*} [CommRing R]

/-- Each component of `a ⨯₃ b` lies in the ideal generated by the components of
`a`. -/
lemma cross_mem_span_left (a b : Fin 3 → R) (j : Fin 3) :
    (a ⨯₃ b) j ∈ Ideal.span (Set.range a) := by
  have h : ∀ l, a l ∈ Ideal.span (Set.range a) := fun l => Ideal.subset_span ⟨l, rfl⟩
  fin_cases j <;> simp only [cross_apply] <;>
    exact sub_mem (Ideal.mul_mem_right _ _ (h _)) (Ideal.mul_mem_right _ _ (h _))

/-- …and of `b`. -/
lemma cross_mem_span_right (a b : Fin 3 → R) (j : Fin 3) :
    (a ⨯₃ b) j ∈ Ideal.span (Set.range b) := by
  have h : ∀ l, b l ∈ Ideal.span (Set.range b) := fun l => Ideal.subset_span ⟨l, rfl⟩
  fin_cases j <;> simp only [cross_apply] <;>
    exact sub_mem (Ideal.mul_mem_left _ _ (h _)) (Ideal.mul_mem_left _ _ (h _))

end Cross

/-! ### `I_{k+1} ⊆ I_k`, and the reverse after inverting the incidence form -/

/-- **`I_{k+1} ⊆ I_k`**: the components of `D(w_k) ⨯ v_{k+1}` are combinations of
those of `D(w_k)`, which generate `I_k` (`span_D`). -/
theorem Ik_succ_le (n : ℕ) : Ik (F := F) (n + 3) ≤ Ik (n + 2) := by
  rw [Ik, Ideal.span_le]
  rintro _ ⟨j, rfl⟩
  rw [SetLike.mem_coe, Ik, ← span_D]
  exact cross_mem_span_left _ _ j

/-- **The key identity**: `inc (n+1) · D(w (n+2)) = D(v (n+1)) ⨯ w (n+3)`,
componentwise.  The article's `(v_{k-1} · D(v_k)) D(w_{k-1}) = D(v_{k-1}) ⨯ w_k`
with `k = n + 3`. -/
theorem inc_mul_eq_cross (n : ℕ) :
    inc (F := F) (n + 1) • D (w (n + 2)) = D (v (n + 1)) ⨯₃ w (F := F) (n + 3) := by
  have h0 : (v (n + 1) : Fin 3 → MvPolynomial (Fin 3 × ℕ) F) ⬝ᵥ w (n + 2) = 0 := by
    rw [w_eq_dir_cross]
    exact dot_cross_self _ _
  have hau : D (w (F := F) (n + 2)) ⬝ᵥ D (v (n + 1)) = 0 := by
    rw [dot_D, D_D, dotProduct_comm]
    exact h0
  have hab : D (v (n + 1)) ⬝ᵥ v (n + 2) = inc (F := F) (n + 1) := by
    rw [inc, dot_D]
  show _ = D (v (n + 1)) ⨯₃ (D (w (n + 2)) ⨯₃ v (n + 2))
  rw [cross_cross_eq_smul_sub_smul', hab, hau, zero_smul, sub_zero]

/-- So `inc (n+1) · I_{k-1} ⊆ I_k`, generator by generator. -/
theorem inc_mul_mem_Ik (n : ℕ) (j : Fin 3) :
    inc (F := F) (n + 1) * D (w (n + 2)) j ∈ Ik (n + 3) := by
  have := congrFun (inc_mul_eq_cross (F := F) n) j
  rw [Pi.smul_apply, smul_eq_mul] at this
  rw [this, Ik]
  exact cross_mem_span_right _ _ j

/-! ### Localizing at `P_j` -/

/-- Some component of the direction is not in `P n`: at the witness point, with
block `n + 1` set to the direction itself, the direction does not vanish. -/
theorem exists_dir_not_mem_P (n : ℕ) : ∃ i, dir (F := F) n i ∉ P n := by
  set a := evalv (ptNd (F := F)) (dir n) with ha
  obtain ⟨i, hi⟩ := exists_evalv_dir_ptNd_ne_zero (F := F) n
  let x : Fin 3 × ℕ → F := fun q => if q.2 = n + 1 then a q.1 else ptNd q
  have hdir : evalv x (dir n) = a :=
    evalv_dir_congr n fun q hq => by
      have : q.2 ≠ n + 1 := by omega
      simp [x, this]
  refine ⟨i, not_mem_P_of_eval x 1 (fun j => ?_) ?_⟩
  · have := congrFun hdir j
    simp only [evalv_apply] at this
    simp [x, this]
  · have := congrFun hdir i
    simp only [evalv_apply] at this
    rw [this]
    exact hi

/-- An element outside `P` becomes a unit in `R_P`, so it can be cancelled from a
membership in an extended ideal. -/
lemma mem_map_of_mul_mem {P : Ideal (MvPolynomial (Fin 3 × ℕ) F)} [P.IsPrime]
    {I : Ideal (MvPolynomial (Fin 3 × ℕ) F)} {s f : MvPolynomial (Fin 3 × ℕ) F} (hs : s ∉ P)
    (h : s * f ∈ I) :
    algebraMap _ (Localization.AtPrime P) f ∈ I.map (algebraMap _ (Localization.AtPrime P)) := by
  obtain ⟨u, hu⟩ := IsLocalization.map_units (Localization.AtPrime P) (⟨s, hs⟩ : P.primeCompl)
  have hmem := Ideal.mem_map_of_mem (algebraMap _ (Localization.AtPrime P)) h
  rw [map_mul, ← hu] at hmem
  have e : algebraMap _ (Localization.AtPrime P) f =
      ↑u⁻¹ * (↑u * algebraMap _ (Localization.AtPrime P) f) := by
    rw [← mul_assoc, Units.inv_mul, one_mul]
  rw [e]
  exact Ideal.mul_mem_left _ _ hmem

/-- **`(R₀)` at the new component**: `I_k R_{P_k} = P_k R_{P_k}`. -/
theorem map_Ik_eq_map_P (n : ℕ) :
    (Ik (F := F) (n + 2)).map (algebraMap _ (Localization.AtPrime (P (F := F) n))) =
      (P (F := F) n).map (algebraMap _ (Localization.AtPrime (P (F := F) n))) := by
  apply le_antisymm (Ideal.map_mono (Ik_le_P le_rfl))
  rw [Ideal.map_le_iff_le_comap]
  intro f hf
  obtain ⟨i, hi⟩ := exists_dir_not_mem_P (F := F) n
  obtain ⟨N, hN⟩ := exists_pow_mul_mem_Ik i hf
  exact mem_map_of_mul_mem (fun h => hi ((P_isPrime n).mem_of_pow_mem N h)) hN

/-- **One step up**: at `P_j` with `j ≤ k - 1`, `I_k` and `I_{k-1}` have the same
extension to `R_{P_j}` (Lean: `k = n + 3`, `j = m + 2`). -/
theorem map_Ik_succ_eq {m n : ℕ} (h : m ≤ n) :
    (Ik (F := F) (n + 3)).map (algebraMap _ (Localization.AtPrime (P (F := F) m))) =
      (Ik (F := F) (n + 2)).map (algebraMap _ (Localization.AtPrime (P (F := F) m))) := by
  apply le_antisymm (Ideal.map_mono (Ik_succ_le n))
  rw [Ik, ← span_D, Ideal.map_span, Ideal.span_le]
  rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
  exact mem_map_of_mul_mem (inc_not_mem_P (by omega)) (inc_mul_mem_Ik n j)

/-- **`(R₀)`.**  For every `2 ≤ j ≤ k`, `I_k` generates the maximal ideal of the
local ring `R_{P_j}` (Lean: `j = m + 2`). -/
theorem map_Ik_eq_maximalIdeal {m k : ℕ} (h : m + 2 ≤ k) :
    (Ik (F := F) k).map (algebraMap _ (Localization.AtPrime (P (F := F) m))) =
      IsLocalRing.maximalIdeal (Localization.AtPrime (P (F := F) m)) := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal]
  induction k, h using Nat.le_induction with
  | base => exact map_Ik_eq_map_P m
  | succ k hk ih =>
    obtain ⟨n, rfl⟩ : ∃ n, k = n + 2 := ⟨k - 2, by omega⟩
    rw [map_Ik_succ_eq (by omega), ih]

/-- **`(R₀)`, as the article states it**: `R_{P_j} / I_k R_{P_j}` — that is,
`(R/I_k)` localized at `P_j` — is a field. -/
theorem isField_localization_quotient {m k : ℕ} (h : m + 2 ≤ k) :
    IsField (Localization.AtPrime (P (F := F) m) ⧸
      (Ik (F := F) k).map (algebraMap _ (Localization.AtPrime (P (F := F) m)))) := by
  rw [map_Ik_eq_maximalIdeal h]
  exact (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).1 (IsLocalRing.maximalIdeal.isMaximal _)

/-! ### No hypothesis on the characteristic

The article works over a field of characteristic `≠ 2` throughout, and checks
characteristic 2 only by computation (`F₂`, `F₄` in its Methods section).  Nothing
in `MinimalPrimes.lean` or this file uses the characteristic, so the count and
`(R₀)` hold over `F₂` as well; these two `example`s are the regression check. -/

section CharTwo

local instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

example : (Ik (F := ZMod 2) 4).minimalPrimes.ncard = 3 := ncard_minimalPrimes_Ik 2

example : IsField (Localization.AtPrime (P (F := ZMod 2) 0) ⧸
    (Ik (F := ZMod 2) 4).map (algebraMap _ (Localization.AtPrime (P (F := ZMod 2) 0)))) :=
  isField_localization_quotient (m := 0) (k := 4) (by norm_num)

end CharTwo

end KCommuting
