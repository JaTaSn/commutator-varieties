# `thm-determinantal`: `I_k` is an ideal of `2 × 2` minors

The article's Theorem (determinantal structure): for `k ≥ 3`, `I_k` is the ideal
of `2 × 2` minors of the `2 × 3` matrix with rows `D(w_{k-1})` and `v_k`; at
`k = 2`, of the matrix with rows `v₁`, `v₂`.

Nothing deep: the three components of a cross product `a ⨯₃ b` are, up to sign,
the three `2 × 2` minors of the matrix with rows `a`, `b`.  So the general
statement `span_cross_eq_minorIdeal` holds over any commutative ring, and the
theorem for `I_k` is that statement applied to the two branches of the
recursion for `w`.

Also here, `span_D`: the second "deliberate understatement" of `def-wk`, that
`D(w_k)` and `w_k` generate the same ideal, since `D` only flips signs.  This is
what lets the article (and these sources) carry the untwisted `w_k` although the
encoded bracket is `D(w_k)` (`enc_icomm` in `IteratedIdentity.lean`).

`Ik k` is defined here and used by `PrimeComponents.lean`.

The ideal of minors is generated by *all* ordered pairs of columns rather than
only `c₁ < c₂`; the extra generators are `0` and negatives, so the ideal is the
same, and the definition is the more obviously correct one.
-/
import KCommuting.Independence

open MvPolynomial Matrix

namespace KCommuting

section General

variable {R : Type*} [CommRing R]

/-- The `2 × 2` minor on columns `c₁, c₂` of the `2 × 3` matrix with rows `a`, `b`. -/
def minor2 (a b : Fin 3 → R) (c₁ c₂ : Fin 3) : R :=
  ((Matrix.of ![a, b]).submatrix id ![c₁, c₂]).det

/-- The ideal of `2 × 2` minors of the `2 × 3` matrix with rows `a`, `b`. -/
def minorIdeal (a b : Fin 3 → R) : Ideal R :=
  Ideal.span (Set.range fun c : Fin 3 × Fin 3 => minor2 a b c.1 c.2)

lemma minor2_eq (a b : Fin 3 → R) (c₁ c₂ : Fin 3) :
    minor2 a b c₁ c₂ = a c₁ * b c₂ - a c₂ * b c₁ := by
  simp [minor2, Matrix.det_fin_two]

/-- **The general statement.**  The components of `a ⨯₃ b` generate exactly the
ideal of `2 × 2` minors of the matrix with rows `a`, `b`. -/
theorem span_cross_eq_minorIdeal (a b : Fin 3 → R) :
    Ideal.span (Set.range (a ⨯₃ b)) = minorIdeal a b := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    apply Ideal.subset_span
    fin_cases i
    · exact ⟨(1, 2), by simp [minor2_eq, cross_apply]⟩
    · exact ⟨(2, 0), by simp [minor2_eq, cross_apply]⟩
    · exact ⟨(0, 1), by simp [minor2_eq, cross_apply]⟩
  · rw [minorIdeal, Ideal.span_le]
    rintro _ ⟨⟨c₁, c₂⟩, rfl⟩
    have h0 : (a ⨯₃ b) 0 ∈ Ideal.span (Set.range (a ⨯₃ b)) := Ideal.subset_span ⟨0, rfl⟩
    have h1 : (a ⨯₃ b) 1 ∈ Ideal.span (Set.range (a ⨯₃ b)) := Ideal.subset_span ⟨1, rfl⟩
    have h2 : (a ⨯₃ b) 2 ∈ Ideal.span (Set.range (a ⨯₃ b)) := Ideal.subset_span ⟨2, rfl⟩
    simp only [SetLike.mem_coe]
    fin_cases c₁ <;> fin_cases c₂ <;>
      first
      | (convert Ideal.zero_mem _ using 1; simp [minor2_eq]; done)
      | (convert h0 using 1; simp [minor2_eq, cross_apply]; done)
      | (convert h1 using 1; simp [minor2_eq, cross_apply]; done)
      | (convert h2 using 1; simp [minor2_eq, cross_apply]; done)
      | (convert neg_mem h0 using 1; simp [minor2_eq, cross_apply]; done)
      | (convert neg_mem h1 using 1; simp [minor2_eq, cross_apply]; done)
      | (convert neg_mem h2 using 1; simp [minor2_eq, cross_apply]; done)

end General

variable {F : Type*} [Field F]

/-- The ideal `I_k ⊂ R_k`, generated by the three components of `w k`.  One ambient
ring for every `k`, as throughout these sources. -/
noncomputable def Ik (k : ℕ) : Ideal (MvPolynomial (Fin 3 × ℕ) F) :=
  Ideal.span (Set.range (w k))

/-- **`thm-determinantal`, base case `k = 2`.**  `I₂` is the ideal of `2 × 2`
minors of the matrix with rows `v₁, v₂` (Lean: `v 0`, `v 1`). -/
theorem Ik_two : (Ik 2 : Ideal (MvPolynomial (Fin 3 × ℕ) F)) = minorIdeal (v 0) (v 1) :=
  span_cross_eq_minorIdeal _ _

/-- **`thm-determinantal`, `k ≥ 3`** (written `n + 3`).  `I_k` is the ideal of
`2 × 2` minors of the matrix with rows `D(w_{k-1})` and `v_k` (Lean: `v (k-1)`). -/
theorem Ik_succ (n : ℕ) :
    (Ik (n + 3) : Ideal (MvPolynomial (Fin 3 × ℕ) F)) =
      minorIdeal (D (w (n + 2))) (v (n + 2)) :=
  span_cross_eq_minorIdeal _ _

/-- **`def-wk`'s second understatement.**  `D u` and `u` generate the same ideal,
`D` being sign flips — so it does not matter that the encoded bracket is
`D (w k)` rather than `w k`. -/
theorem span_D (u : Fin 3 → MvPolynomial (Fin 3 × ℕ) F) :
    Ideal.span (Set.range (D u)) = Ideal.span (Set.range u) := by
  have key : ∀ u : Fin 3 → MvPolynomial (Fin 3 × ℕ) F,
      Ideal.span (Set.range (D u)) ≤ Ideal.span (Set.range u) := by
    intro u
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    have hi : u i ∈ Ideal.span (Set.range u) := Ideal.subset_span ⟨i, rfl⟩
    fin_cases i
    · simpa [D] using neg_mem hi
    · simpa [D] using neg_mem hi
    · simpa [D] using hi
  apply le_antisymm (key u)
  simpa using key (D u)

end KCommuting
