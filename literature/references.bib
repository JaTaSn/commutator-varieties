@book{BrunsVetter1988,
  author = {Bruns, Winfried and Vetter, Udo},
  title = {Determinantal Rings},
  series = {Lecture Notes in Mathematics},
  volume = {1327},
  publisher = {Springer-Verlag},
  address = {Berlin Heidelberg},
  year = {1988},
  note = {Out of print; freely available with Springer's permission at the first author's own
          page. Theorem (2.7) (p.\ 13) is the general "grade at expected value $\Rightarrow$
          perfect" result for the ideal of maximal minors of an arbitrary matrix (not just
          independent-indeterminate entries) -- exactly the hypothesis needed for
          Proposition~3/Theorem~4.6 in this project's article. Theorem (16.36) (p.\ 217,
          Appendix~16.F "The Theorem of Hilbert-Burch") is the codimension-2 structure theorem
          itself, with an explicit remark that its hypotheses hold whenever $A$ is a polynomial
          ring over a field, $\mathrm{grade}(I)=2$, and $A/I$ is Cohen-Macaulay -- this project's
          exact situation.},
  url = {https://www.home.uni-osnabrueck.de/wbruns/brunsw/detrings.pdf},
}

@article{EagonNorthcott1962,
  author = {Eagon, John A. and Northcott, Douglas Geoffrey},
  title = {Ideals defined by matrices and a certain complex associated with them},
  journal = {Proceedings of the Royal Society of London. Series A. Mathematical and Physical Sciences},
  volume = {269},
  number = {1337},
  pages = {188--204},
  year = {1962},
  doi = {10.1098/rspa.1962.0170},
  note = {The original construction of the Eagon-Northcott complex. Confirmed via Crossref
          (DOI, volume/page) 2026-08-16; closed access via Unpaywall (no OA location found), but
          obtained the same day via JSTOR through Jan's LiU institutional access -- see
          \texttt{literature/subscription/eagon-northcott1962\_ideals-defined-by-matrices.pdf}.
          Read directly (not just via Bruns-Vetter's secondhand treatment) 2026-08-16: Theorem 2,
          \S5, p.\ 201 is the exact result this project's Proposition~21 needs, and -- contrary to
          the "supersedes/more general hypotheses" note this bib entry previously carried -- it
          already has \emph{no} genericity or indeterminate-entries hypothesis: arbitrary
          Noetherian $R$, arbitrary $s\times r$ matrix, only the grade condition
          $\mathrm{gr}\{(A);R\}=r-s+1$ is assumed. See
          \texttt{working-notes/eagon-northcott-1962-primary-source.org} for the full read-through
          and an explicit $I_3$ example; Bruns-Vetter is not actually needed to cover a gap in the
          original 1962 theorem, though it remains a fine modern-textbook citation if preferred for
          exposition.},
}
