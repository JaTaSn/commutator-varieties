# 2026-08-19 (Claude): the general fact behind "any invertible linear re-encoding of a traceless
# 2x2 matrix as a triple gives an ISOMORPHIC ideal I_k, not merely a plausible-sounding one" --
# checked directly here rather than just asserted, since it is the load-bearing claim for why
# adopting a different encoding (see working-notes/alternative-encodings-musings.org) doesn't
# require re-proving codim/CM/radical/component-count from scratch.
#
# Classical fact used: for M in GL(3,FF) and a,b in FF^3,
#     (M a) x (M b) = det(M) * (M^{-1})^T (a x b).
# Checked below as a polynomial identity in 3+3+9 = 15 free variables (a, b, and M's 9 entries,
# with det(M) inverted formally by working over the fraction field). Consequence: crossing two
# M-re-encoded vectors always lands you back in an invertible-linear image of the un-re-encoded
# cross product -- so "the ideal generated by the components of (Ma) x (Mb)" always equals "the
# ideal generated by the components of a x b" (an invertible matrix mixing a generating set doesn't
# change the ideal generated), regardless of which invertible M is chosen. This is the general
# statement of which the red()/tau() encoding and the enc()/D() encoding
# (verify_lorentzian_encoding_identity.sage) are just two particular instances.

Rgens = ['a1','a2','a3','b1','b2','b3'] + ['m%d%d' % (i,j) for i in range(3) for j in range(3)]
Rbase = PolynomialRing(QQ, Rgens)
F = Rbase.fraction_field()

a = vector(F, [F('a1'), F('a2'), F('a3')])
b = vector(F, [F('b1'), F('b2'), F('b3')])
M = matrix(F, 3, 3, [F('m%d%d' % (i,j)) for i in range(3) for j in range(3)])

def cross(u, v):
    return vector(F, [u[1]*v[2]-u[2]*v[1], u[2]*v[0]-u[0]*v[2], u[0]*v[1]-u[1]*v[0]])

lhs = cross(M*a, M*b)
rhs = M.det() * (M.inverse().transpose()) * cross(a, b)
diff = lhs - rhs
print("(Ma) x (Mb) - det(M)(M^-1)^T (a x b) =", diff.list())
print("identity holds (as rational functions in M's entries)?", all(d == 0 for d in diff.list()))

# --- Sanity check with the two SPECIFIC M's this project actually cares about ---
# M_tau: red(A) -> tau applied afterwards is a post-composition, not a re-encoding of the INPUT --
# skip; the two re-encodings actually in play are red (identity, M=I) and enc (M below, mapping
# red's (a12,a21,d_a) = (y,z,2x) to enc's (2x,y+z,y-z)).
M_enc = matrix(QQ, 3, 3, [[0,0,1],[1,1,0],[1,-1,0]])
print()
print("M_enc (red -> enc change of basis) =\n", M_enc)
print("det(M_enc) =", M_enc.det(), " (matches tau's own det = -2, coincidentally or not)")

# --- Triviality of the generator-count argument under enc()/D(): D only rescales each generator
# by a UNIT (+-1), never mixes two generators together the way tau's coordinate swap does. Verify
# this really does preserve the ideal at k=2,3 by direct Groebner-basis containment (not just "it's
# obviously true for a diagonal matrix") -- belt and suspenders, matching this project's own
# verification-first house style.
R3 = PolynomialRing(QQ, ['v1_1','v1_2','v1_3','v2_1','v2_2','v2_3'])
v1 = vector(R3, R3.gens()[0:3])
v2 = vector(R3, R3.gens()[3:6])
def cross3(u, w):
    return vector(R3, [u[1]*w[2]-u[2]*w[1], u[2]*w[0]-u[0]*w[2], u[0]*w[1]-u[1]*w[0]])
w2 = cross3(v1, v2)
Dmat = matrix(QQ, 3, 3, [[-1,0,0],[0,-1,0],[0,0,1]])
Dw2 = Dmat * w2
I_raw = R3.ideal(list(w2))
I_D   = R3.ideal(list(Dw2))
print()
print("ideal(w2) == ideal(D w2) ?", I_raw == I_D)
